{
  "name": "strikegy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run clean && vite build",
    "preview": "vite preview",
    "server:build": "vite build -c server/vite.config.ts",
    "server": "npm run server:build && node dist-server/main.js",
    "server:bench": "npm run server:build && node dist-server/bench.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node scripts/clean.mjs",
    "assets": "node scripts/fetch-assets.mjs && node scripts/optimize-assets.mjs",
    "sounds": "node scripts/build-sounds.mjs",
    "maps": "node scripts/maps/iron-gate.mjs && node scripts/maps/ardennes.mjs && node scripts/maps/lyon.mjs && node scripts/maps/persia.mjs && node scripts/maps/bilbao.mjs",
    "props:bounds": "node scripts/prop-bounds.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "recast-navigation": "^0.43.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}

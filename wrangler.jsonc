// The multiplayer signalling server on Cloudflare Workers (`npm run signal:deploy`).
// Secrets (optional, for TURN): `npx wrangler secret put CF_TURN_KEY_ID` / `CF_TURN_API_TOKEN`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strikegy-signal",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "SignalHub" }]
  },
  // Workers Free allows only SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalHub"] }],
  "observability": { "enabled": true }
}

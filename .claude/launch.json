{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "strikegy-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "strikegy-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8787
    },
    {
      "name": "strikegy-server-udp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8787,
      "env": {
        "STRIKEGY_RTC_LOCAL": "1"
      }
    },
    {
      "name": "strikegy-edge",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dist-server/edge.js"
      ],
      "port": 18788,
      "env": {
        "EDGE_UPSTREAM": "ws://127.0.0.1:8787/play",
        "EDGE_UDP_PORT": "50000"
      }
    }
  ]
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "strikegy-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "strikegy-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8787
    },
    {
      "name": "strikegy-server-udp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8787,
      "env": {
        "STRIKEGY_RTC_LOCAL": "1"
      }
    }
  ]
}
